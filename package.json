{
  "name": "baller-connection",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src shared server",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.mjs",
    "api": "tsx server/node.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "build:live": "tsc -b && VITE_API_URL=same-origin vite build --outDir dist-live",
    "build:worker": "tsc -b && BASE=/ VITE_API_URL=same-origin vite build",
    "serve:local": "npm run build:live && DIST=dist-live tsx server/node.ts",
    "test:e2e:multi": "node tests/e2e-multi.mjs",
    "db:migrate:local": "wrangler d1 migrations apply baller-connection --local",
    "db:migrate:remote": "wrangler d1 migrations apply baller-connection --remote",
    "deploy": "npm run build:worker && wrangler deploy",
    "stripe:setup": "tsx scripts/stripe-setup.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "1.59",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
